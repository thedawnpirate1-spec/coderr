{
  "info": {
    "name": "Coderr API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "In Reihenfolge im Collection Runner ausfuehren. Erstellt zwei neue Testnutzer sowie eine Bestellung. Nur auf einer lokalen Testinstanz verwenden. base_url anpassen."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Statistik oeffentlich\") { pm.collectionVariables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16)); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Statistik oeffentlich",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/base-info/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Statistik vorhanden\", () => pm.expect(pm.response.json()).to.have.all.keys(\"review_count\", \"average_rating\", \"business_profile_count\", \"offer_count\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Bestellungen ohne Token abweisen",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/orders/"
