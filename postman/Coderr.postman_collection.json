        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrierung business",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"business_{{run_id}}\",\n  \"email\": \"business_{{run_id}}@example.com\",\n  \"password\": \"Postman-Test-83!\",\n  \"repeated_password\": \"Postman-Test-83!\",\n  \"type\": \"business\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const d=pm.response.json(); pm.test(\"Token vorhanden\", () => pm.expect(d.token).to.be.a(\"string\").and.not.empty); pm.collectionVariables.set(\"business_token\",d.token); pm.collectionVariables.set(\"business_id\",d.user_id);"
            ]
          }
        }
      ]
    },
